		D:/lib/Qt/6.11.2/mingw_64/bin/rcc.exe
	D:\lib\Qt\6.11.2\mingw_64\bin\rcc.exe -name Resources --no-zstd ..\..\Resources.qrc -o debug\qrc_Resources.cpp

