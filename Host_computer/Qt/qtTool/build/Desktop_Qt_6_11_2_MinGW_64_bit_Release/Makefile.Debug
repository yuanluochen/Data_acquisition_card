	-$(DEL_FILE) debug\adcrecord.o debug\adcwave.o debug\crc.o debug\ddsdac.o debug\main.o debug\mainwindow.o debug\qcustomplot.o debug\zlos_netPort.o debug\zlos_uartPort.o debug\qrc_Resources.o debug\moc_adcrecord.o debug\moc_adcwave.o debug\moc_ddsdac.o debug\moc_mainwindow.o debug\moc_qcustomplot.o debug\moc_zlos_netPort.o debug\moc_zlos_uartPort.o

distclean: clean 
	-$(DEL_FILE) .qmake.stash
	-$(DEL_FILE) $(DESTDIR_TARGET)
	-$(DEL_FILE) Makefile.Debug

mocclean: compiler_moc_header_clean compiler_moc_objc_header_clean compiler_moc_source_clean

mocables: compiler_moc_header_make_all compiler_moc_objc_header_make_all compiler_moc_source_make_all

check: first

benchmark: first

